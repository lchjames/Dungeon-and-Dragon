{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dnd",
  // Runtime Map Object handling is embedded inside runtime-story-lifecycle-gateway.js before delegation to the Runtime Encounter / Story / Map chain.
  // Delegated downstream contracts include runtime-encounter-resolution-gateway.js, runtime-encounter-gateway.js, story-zone-trigger-gateway.js, story-event-gateway.js, runtime-visibility-gateway.js, hostile-combat-movement-gateway.js, runtime-door-gateway.js, player-rest.js, player-map-gateway.js, player-map.js, runtime-map.js, world-map-editor.js, world-map.js, player-monster-audit-compat.js, admin-gateway.js and admin-auth.js.
  "main": "./src/runtime-story-lifecycle-gateway.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dungeon-and-dragon.lchjames.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dnd-db",
      "database_id": "7a9abf7b-5f87-4295-89b1-8187e991b782"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/player",
      "/player/*",
      "/gm",
      "/gm/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}

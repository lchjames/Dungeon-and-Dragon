{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dnd",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dungeon-and-dragon.lchjames.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/player",
      "/player/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}

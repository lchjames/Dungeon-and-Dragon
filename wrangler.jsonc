{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dungeon-and-dragon",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dungeon-and-dragon.lchjames.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}

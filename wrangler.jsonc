{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dnd",
  "main": "./src/life-correction.js",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dungeon-and-dragon.lchjames.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dnd-db",
      "database_id": "7a9abf7b-5f87-4295-89b1-8187e991b782"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/player",
      "/player/*",
      "/gm",
      "/gm/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
